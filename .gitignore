# Secrets and local configuration
.env
.env.*
!.env.example
*serviceaccount*.json
*service-account*.json
*credentials*.json
firebase-adminsdk-*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local databases and dumps
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql
*.dump
.local-dev.db
.migration-scratch.db

# Local file storage for development uploads
.local-storage/

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
htmlcov/
.coverage
.coverage.*

# Every run writes its console output here, kept for the last few runs.
logs/

# Terraform: state carries secret values in plaintext, and *.tfvars is where
# gemini_api_key/fcm_credentials_json actually get filled in (see
# infra/terraform/terraform.tfvars.example, which is NOT ignored by this).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
