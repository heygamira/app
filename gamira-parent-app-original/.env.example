# Copy to .env for local development. Never commit .env.

# The voice prototype's key. Server-side only in the long run; local-only for
# now via the standalone token server. Never put a secret behind a VITE_
# prefix — Vite compiles those into the client bundle.
GEMINI_API_KEY=

# Firebase web config, from Firebase console > Project settings > Your apps >
# Web app. None of this is secret — it identifies the project, it doesn't
# authorize anything by itself, so it's fine that Vite compiles it into the
# client bundle. Leave all of these unset to run without Google/email
# sign-in — AUTH_MODE=dev and the dev-identity dropdown work either way.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair's public "key pair" value, from Firebase
# console > Project settings > Cloud Messaging > Web configuration > Web
# Push certificates. Also not a secret — it authorizes nothing without the
# signed-in session that goes with it — but push registration quietly does
# nothing (see `src/lib/usePushRegistration.js`) without it set.
VITE_FIREBASE_VAPID_KEY=
