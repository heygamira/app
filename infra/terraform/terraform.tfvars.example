# Copy to terraform.tfvars (already gitignored — see .gitignore) and fill in.
# Never commit the real file: gemini_api_key and fcm_credentials_json are
# secrets, and project_id/firebase_project_id are worth keeping out of a
# public diff even though they're not secret by themselves.

project_id           = "gamira-staging-XXXXXX"
region                = "asia-south1"
environment           = "staging"
# https://localhost is the default WebView origin for a Capacitor Android
# app (both the Family Dashboard and Parent App packages) — required for
# either app's installed build to reach this API at all.
cors_origins          = "https://staging.gamira.online,https://dashboard-staging.gamira.online,https://localhost"
firebase_project_id   = "gamira-staging-XXXXXX"

# Secret Manager rejects an empty-string payload outright, and Cloud Run's
# containers reference these secrets' "latest" version to even start — so
# the first apply needs a real placeholder, not an empty string. Use
# gcloud/console to rotate real values in after; a secret version can be
# added out of band without another `terraform apply`.
gemini_api_key        = "REPLACE_WITH_REAL_GEMINI_API_KEY"
fcm_credentials_json  = "{}"

# Leave backend_image at its placeholder default until the first image is
# actually pushed to Artifact Registry (see README.md's ordering) — Cloud Run
# will run the Google-provided hello image until then, which is expected.
