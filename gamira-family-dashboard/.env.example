# Copy to .env.local for local development. Never commit .env.local.

# Where the Gamira API lives. Left unset, the app calls /api/v1 and the Vite
# dev server proxies that to http://localhost:8000 (see vite.config.js).
# VITE_GAMIRA_API_URL=http://localhost:8000/api/v1

# Skip the sign-in screen during local UI work by signing in as a seeded
# development identity. Only works while the backend runs with AUTH_MODE=dev.
# VITE_BYPASS_AUTH=true
# VITE_DEV_AUTH_SUBJECT=sharma-owner

# Firebase web config, from Firebase console > Project settings > Your apps >
# Web app. None of this is secret — it identifies the project, it doesn't
# authorize anything by itself, so it's fine that Vite compiles it into the
# client bundle (unlike a real secret, which should never carry a VITE_
# prefix). Leave all of these unset to run without Google/email sign-in —
# AUTH_MODE=dev and the dev-identity dropdown work either way.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Web Push certificate ("VAPID") key, from Firebase console > Project
# settings > Cloud Messaging > Web configuration. Also not a secret — it's a
# public key used to identify push subscription requests as coming from this
# project, the same reasoning as the block above. Required for push
# notifications to work; leave unset to run without them.
VITE_FIREBASE_VAPID_KEY=
