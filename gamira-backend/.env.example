# Copy to .env for local development. Never commit .env.
APP_ENV=local
API_PORT=8000
# Named GAMIRA_DEBUG, not DEBUG: many machines and tools already set a DEBUG
# env var that isn't "true"/"false", which crashes settings loading.
GAMIRA_DEBUG=false

# Docker Compose publishes PostgreSQL on 5432 with these credentials.
DATABASE_URL=postgresql+asyncpg://gamira:gamira@localhost:5432/gamira

# Only the local client origins. Never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# dev  - accepts "dev:<subject>" bearer tokens, local and test only
# firebase - verifies real Firebase ID tokens (requires FIREBASE_PROJECT_ID)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# fake - records what would have been sent without calling anyone. The only
#        value the test suite uses; refused outside local/test.
# firebase - sends through FCM HTTP v1. Needs a real service-account key from
#            the same Firebase project as FIREBASE_PROJECT_ID above
#            (console -> Project settings -> Service accounts -> Generate new
#            private key). Never commit that file; FCM_CREDENTIALS_FILE only
#            holds a local path to it.
FCM_PROVIDER=fake
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
FCM_TIMEOUT_SECONDS=10.0

LOG_LEVEL=INFO
LOG_FORMAT=console

# Server-side only. Must never be exposed to a client bundle.
GEMINI_API_KEY=
# The text layer: chat replies and weekly summaries.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=./.local-storage
